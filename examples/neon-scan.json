{
  "id": "neon-scan",
  "name": {
    "zh": "赛博霓虹",
    "en": "Neon Scan"
  },
  "description": {
    "zh": "紫粉光带 + 水平扫描线 + 网格地平线，节奏偏快。",
    "en": "Purple-pink light bands, scanlines and a grid horizon; brisk pacing."
  },
  "theme": "dark",
  "document": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>DeepSeek Harness</title>\n<style>\n  :root { color-scheme: dark; }\n  * { box-sizing: border-box; }\n  html, body { height: 100%; margin: 0; }\n  body {\n    overflow: hidden; color: #fff0ff;\n    background: radial-gradient(120% 80% at 50% 110%, #2a0b46 0%, #120726 46%, #05030f 100%);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  }\n  .glow { position: fixed; inset: 0; }\n  .band { position: absolute; left: -20%; right: -20%; height: 30vh; filter: blur(42px); mix-blend-mode: screen; }\n  .band.pink {\n    top: 14%; background: linear-gradient(90deg, transparent, #ff2fb0 20%, #ff7ae0 48%, #b06bff 72%, transparent);\n    opacity: .55; animation: sweep 3.6s ease-in-out infinite alternate;\n  }\n  .band.violet {\n    top: 30%; height: 22vh; background: linear-gradient(90deg, transparent, #7b2bff 18%, #37f0ff 55%, #ff2fb0 82%, transparent);\n    opacity: .38; animation: sweep 5.1s ease-in-out infinite alternate-reverse;\n  }\n  @keyframes sweep {\n    0%   { transform: translate3d(-7%, -2%, 0) scaleY(.92) }\n    100% { transform: translate3d(7%, 3%, 0) scaleY(1.12) }\n  }\n  .grid {\n    position: absolute; left: -10%; right: -10%; bottom: -6%; height: 42%;\n    background-image:\n      linear-gradient(rgba(255,80,210,.30) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(120,80,255,.26) 1px, transparent 1px);\n    background-size: 100% 22px, 46px 100%;\n    transform: perspective(320px) rotateX(66deg);\n    mask-image: linear-gradient(to top, #000 8%, transparent 78%);\n    -webkit-mask-image: linear-gradient(to top, #000 8%, transparent 78%);\n    animation: crawl 2.6s linear infinite;\n  }\n  @keyframes crawl { to { background-position: 0 22px, 0 0 } }\n  .scan {\n    position: absolute; inset: 0; pointer-events: none; opacity: .5;\n    background: repeating-linear-gradient(to bottom, rgba(255,255,255,.055) 0 1px, transparent 1px 3px);\n  }\n  .rim {\n    position: absolute; left: 50%; top: 50%; width: min(74vmin, 620px); aspect-ratio: 1;\n    transform: translate(-50%,-50%);\n    background: radial-gradient(circle, rgba(255,47,176,.20) 0%, rgba(123,43,255,.12) 42%, transparent 70%);\n  }\n  .card { position: fixed; inset: 0; display: grid; place-items: center; text-align: center; }\n  .mark {\n    width: min(14vmin, 116px); height: auto; margin-bottom: 20px;\n    filter: drop-shadow(0 0 26px rgba(255,47,176,.75)) drop-shadow(0 0 60px rgba(123,43,255,.5));\n    animation: bob 2.4s ease-in-out infinite;\n  }\n  @keyframes bob { 0%,100% { transform: translateY(-3px) } 50% { transform: translateY(4px) } }\n  .title {\n    font-size: clamp(15px, 2vmin, 21px); font-weight: 700; letter-spacing: .44em; text-indent: .44em; text-transform: uppercase;\n    color: #fff; text-shadow: 0 0 6px #fff, 0 0 18px #ff2fb0, 0 0 44px #7b2bff;\n  }\n  .sub { margin-top: 12px; font-size: 12px; letter-spacing: .26em; color: rgba(255,214,255,.62); font-variant-numeric: tabular-nums; }\n  .bar {\n    position: relative; margin: 26px auto 0; width: min(44vmin, 320px); height: 3px; border-radius: 999px;\n    background: rgba(255,255,255,.10); overflow: hidden;\n  }\n  .bar i {\n    display: block; height: 100%; width: 0%; border-radius: inherit;\n    background: linear-gradient(90deg, #37f0ff, #ff2fb0 55%, #b06bff);\n    box-shadow: 0 0 12px rgba(255,47,176,.9), 0 0 26px rgba(123,43,255,.6);\n    transition: width .18s cubic-bezier(.22,.61,.36,1);\n  }\n  body.done .band { animation-duration: 9s; opacity: .3; }\n  @media (prefers-reduced-motion: reduce) {\n    .band, .grid, .mark { animation: none !important; }\n    .bar i { transition: none; }\n  }\n</style>\n</head>\n<body>\n  <div class=\"glow\">\n    <div class=\"band violet\"></div>\n    <div class=\"band pink\"></div>\n    <div class=\"rim\"></div>\n    <div class=\"grid\"></div>\n    <div class=\"scan\"></div>\n  </div>\n  <div class=\"card\">\n    <div>\n      <svg class=\"mark\" viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n        <defs>\n          <linearGradient id=\"neon\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#37f0ff\"/>\n            <stop offset=\".5\" stop-color=\"#ff7ae0\"/>\n            <stop offset=\"1\" stop-color=\"#b06bff\"/>\n          </linearGradient>\n        </defs>\n        <path fill=\"url(#neon)\" d=\"M48.8354 10.0479C48.3232 9.79199 48.1025 10.2798 47.8032 10.5278C47.7007 10.6079 47.6143 10.7119 47.5273 10.8076C46.7793 11.624 45.9048 12.1597 44.7622 12.0957C43.0923 12 41.666 12.5356 40.4058 13.8398C40.1377 12.2319 39.2476 11.272 37.8926 10.6558C37.1836 10.3359 36.4668 10.0156 35.9702 9.31982C35.6235 8.82373 35.5293 8.27197 35.356 7.72754C35.2456 7.3999 35.1353 7.06396 34.7651 7.00781C34.3633 6.94385 34.2056 7.2876 34.0479 7.57568C33.418 8.75195 33.1733 10.0479 33.1973 11.3599C33.2524 14.312 34.4736 16.6641 36.8999 18.3359C37.1758 18.5278 37.2466 18.7197 37.1597 19C36.9946 19.5757 36.7974 20.1357 36.624 20.7119C36.5137 21.0801 36.3486 21.1597 35.9624 21C34.6309 20.4321 33.481 19.5918 32.4644 18.5757C30.7393 16.8721 29.1792 14.9917 27.2334 13.52C26.7764 13.1758 26.3193 12.856 25.8467 12.5518C23.8618 10.584 26.1069 8.96777 26.627 8.77588C27.1704 8.57568 26.8159 7.8877 25.0591 7.896C23.3022 7.90381 21.6953 8.50391 19.647 9.30371C19.3477 9.42383 19.0322 9.51172 18.7095 9.58398C16.8501 9.22363 14.9199 9.14355 12.9033 9.37598C9.10596 9.80762 6.07275 11.6396 3.84326 14.7681C1.16455 18.5278 0.53418 22.7998 1.30664 27.2559C2.11768 31.9521 4.46582 35.8398 8.07373 38.8799C11.8159 42.0322 16.1255 43.5762 21.041 43.2803C24.0269 43.104 27.3516 42.6963 31.1016 39.4561C32.0469 39.936 33.0396 40.1279 34.686 40.272C35.9546 40.3921 37.1758 40.208 38.1211 40.0078C39.6021 39.688 39.4995 38.2881 38.9639 38.0322C34.623 35.9678 35.5762 36.8081 34.71 36.1279C36.9155 33.4639 40.2402 30.6958 41.54 21.728C41.6426 21.0161 41.5557 20.5679 41.54 19.9917C41.5322 19.6396 41.6108 19.5039 42.0049 19.4639C43.0923 19.3359 44.1479 19.0317 45.1167 18.4878C47.9292 16.9199 49.064 14.3438 49.3315 11.2559C49.3711 10.7837 49.3237 10.2959 48.8354 10.0479Z\"/>\n      </svg>\n      <div class=\"title\">DeepSeek Harness</div>\n      <div class=\"sub\" id=\"sub\">正在接入…</div>\n      <div class=\"bar\"><i id=\"bar\"></i></div>\n    </div>\n  </div>\n<script>\n(function () {\n  var bar = document.getElementById('bar');\n  var sub = document.getElementById('sub');\n  var bridge = window.dshBootAnim;\n  var STAGES = [[0, '正在接入…'], [0.3, '正在唤醒插件…'], [0.66, '正在同步会话…'], [1, '链路就绪']];\n  function render(p) {\n    p = Math.max(0, Math.min(1, Number(p) || 0));\n    bar.style.width = (p * 100).toFixed(1) + '%';\n    var text = STAGES[0][1];\n    for (var i = 0; i < STAGES.length; i++) if (p >= STAGES[i][0]) text = STAGES[i][1];\n    if (sub.textContent !== text) sub.textContent = text;\n    document.body.classList.toggle('done', p >= 1);\n  }\n  if (bridge) {\n    render(bridge.progress());\n    bridge.on('progress', render);\n  } else {\n    var t0 = Date.now();\n    setInterval(function () { render(((Date.now() - t0) / 2400) % 1.02); }, 55);\n  }\n})();\n</script>\n</body>\n</html>"
}
